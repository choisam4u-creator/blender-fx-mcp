{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.choisam4u-creator/blender-fx-mcp",
  "title": "Blender FX",
  "description": "AI가 말로 시키면 블렌더에서 건물 파괴·폭발·물·불·파티클 FX를 만드는 MCP 서버",
  "version": "0.6.3",
  "repository": {
    "url": "https://github.com/choisam4u-creator/blender-fx-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "blender-fx-mcp",
      "version": "0.6.3",
      "runtimeHint": "uvx",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        { "name": "BLENDER_FX_PORT", "description": "블렌더 수신기 포트 (기본 9876)", "format": "number", "isRequired": false },
        { "name": "BLENDER_FX_LANG", "description": "메시지 언어 ko 또는 en. 없으면 로캘(한국어면 ko, 아니면 en, 로캘이 없으면 ko) / message language; unset follows the locale", "choices": ["ko", "en"], "isRequired": false },
        { "name": "BLENDER_FX_OUT", "description": "미리보기·영상 저장 폴더 (기본 ~/blender-fx-output)", "format": "filepath", "isRequired": false }
      ]
    }
  ]
}

# 필요할 때만 바꾼다. 기본값은 blender-mcp 수신기 애드온 기본 설정과 같다.
BLENDER_FX_HOST=localhost
BLENDER_FX_PORT=9876
# 굽기·렌더 최대 대기 시간(초)
BLENDER_FX_TIMEOUT=600
# 미리보기 이미지가 저장되는 폴더
BLENDER_FX_OUT=~/blender-fx-output
# 헤드리스 테스트에 쓸 블렌더 실행 파일 (맥 기본 경로면 비워 둔다)
BLENDER_FX_BLENDER=/Applications/Blender.app/Contents/MacOS/Blender
# 메시지 언어: ko(기본) 또는 en
BLENDER_FX_LANG=ko
